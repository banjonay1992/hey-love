{
  "expo": {
    "name": "Hey, Love",
    "slug": "hey-love",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heylove",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.banjonay.heylove",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Hey, Love uses your microphone to keep the voices and sounds you never want to lose.",
        "NSPhotoLibraryUsageDescription": "Hey, Love lets you add photographs to your memories."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F0E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E6",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hey, Love uses your microphone to keep the voices and sounds you never want to lose."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hey, Love lets you add photographs to your memories."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "banjonay",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80e0572c-daca-4c85-87de-cd960a24f306"
      }
    }
  }
}
